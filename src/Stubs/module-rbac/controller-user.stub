<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Controllers;

use App\Modules\{{ModuleName}}\Models\Role;
use App\Modules\{{ModuleName}}\Models\{{ModuleName}};
use App\Modules\{{ModuleName}}\Services\RbacService;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Mk\Director\Auth\Access\ModuleRbacGrantGuard;
use Mk\Director\Controllers\SmartController;

/**
 * {{ModuleName}}Controller — CRUD estándar + asignación/revocación de roles.
 *
 * Generado por `php artisan mk:module {{ModuleName}} --with-rbac`.
 * Extiende `SmartController` para el CRUD; los endpoints `assignRole` /
 * `revokeRole` son específicos del RBAC triad.
 *
 * Usuario y rol se cargan con `findScopedOrFail()`, el lookup del CRUD: con un
 * plugin de tenant, el usuario o el rol de otro tenant da 404. Con un
 * `findOrFail()` pelado, un tenant le asignaba y quitaba roles a los usuarios
 * de otro.
 *
 * Asignar y revocar pasan por `ModuleRbacGrantGuard` (403): nadie cambia sus
 * roles, ni toca a alguien con más acceso, ni asigna o quita un rol con
 * abilities que no tiene (o `super-admin`, sin serlo). La Policy sólo mira si
 * el actor tiene la ability del endpoint, no QUÉ concede. Si sobreescribís
 * estos métodos, conservá la llamada.
 *
 * Spec: RBAC-001, RBAC-005 (R-PKG-008).
 */
class {{ModuleName}}Controller extends SmartController
{
    protected array $mkConfig = [
        'model'           => {{ModuleName}}::class,
        'service'         => RbacService::class,
        'searchable'      => ['name', 'email'],
        'with'            => ['roles'],
        'allowedIncludes' => ['roles', 'roles.abilities'],
        'features'        => [
            'auto_cache'    => true,
            'remember_state' => true,
        ],
    ];

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/roles/{roleId}
     * Asigna un role a un user. Autorizado por `{{ModuleName}}Policy::assignRole`.
     */
    public function assignRole(Request $request, int $id, int $roleId, RbacService $rbac): JsonResponse
    {
        $user = $this->findScopedOrFail($request, $id);
        $role = $this->findScopedOrFail($request, $roleId, Role::class);

        $this->authorize('assignRole', $user);
        app(ModuleRbacGrantGuard::class)->assertCanChangeUserRole($request->user(), $user, $role);

        $rbac->assignRole($user, $role);

        return response()->json([
            'success' => true,
            'message' => 'Role asignado.',
            'data'    => $user->fresh()->load('roles'),
        ]);
    }

    /**
     * DELETE /api/{{moduleNamePluralLower}}/{id}/roles/{roleId}
     * Revoca un role de un user. Autorizado por `{{ModuleName}}Policy::revokeRole`.
     */
    public function revokeRole(Request $request, int $id, int $roleId, RbacService $rbac): JsonResponse
    {
        $user = $this->findScopedOrFail($request, $id);
        $role = $this->findScopedOrFail($request, $roleId, Role::class);

        $this->authorize('revokeRole', $user);
        app(ModuleRbacGrantGuard::class)->assertCanChangeUserRole($request->user(), $user, $role);

        $rbac->revokeRole($user, $role);

        return response()->json([
            'success' => true,
            'message' => 'Role revocado.',
            'data'    => $user->fresh()->load('roles'),
        ]);
    }
}
