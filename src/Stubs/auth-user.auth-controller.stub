<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Mk\Director\Auth\Controllers\BaseAuthController;
{{twoFactorPolicyUse}}use Mk\Director\Auth\Models\AuthUser;

/**
 * Autenticación del scope `{{moduleNameLower}}`.
 *
 * Toda la lógica vive en {@see BaseAuthController}; este controller sólo le dice
 * qué modelo, scope, campo de login y tabla de reset usar. Para comportamiento
 * propio, sobreescribí sus hooks acá:
 *
 *   - `beforeLogin(Request, array)` — ajustar credenciales antes de buscar al usuario
 *   - `afterLogin(Request, Authenticatable, array)` — auditoría después de emitir el token
 *   - `customizeLoginValidationRules()` — reglas extra para el login
 *   - `customizeMePayload(Authenticatable)` — campos extra en `/me`
 *   - `shouldSendResetNotification(Authenticatable, string)` — decidir si se manda el mail de reset
 *
 * Las rutas y su middleware (`mk.auth:{{moduleNameLower}}`, throttles) están en
 * `Http/Routes/api.php`, no en este controller.
 */
class AuthController extends BaseAuthController
{
    /**
     * Modelo del scope.
     *
     * @return class-string<\App\Modules\{{ModuleName}}\Models\{{ModuleName}}>
     */
    protected function authModelClass(): string
    {
        return \App\Modules\{{ModuleName}}\Models\{{ModuleName}}::class;
    }

    /**
     * Scope: el guard del middleware, la marca de los tokens y el prefijo de
     * las abilities.
     */
    protected function authScope(): string
    {
        return '{{moduleNameLower}}';
    }

    /**
     * Campo por el que se valida y se busca al usuario en login y recuperación.
     */
    protected function loginField(): string
    {
        return '{{loginField}}';
    }

    /**
     * Tabla de tokens de reset de contraseña (la crea la migración del scope).
     */
    protected function passwordResetTable(): string
    {
        return '{{moduleNameLower}}_password_reset_tokens';
    }
{{twoFactorPolicyMethod}}{{registerMethod}}{{updateProfileMethod}}}
