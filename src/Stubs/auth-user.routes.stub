<?php

declare(strict_types=1);

use App\Modules\{{ModuleName}}\Http\Controllers\AuthController;
use Illuminate\Support\Facades\Route;

/**
 * Rutas del scope `{{moduleNameLower}}` — generadas por
 * `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Las rutas protegidas usan `mk.auth:{{moduleNameLower}}` (del paquete) que
 * valida en 3 capas que el token pertenece al scope correcto (ver
 * docs/guides/AUTH.md § "The 4 defense layers against cross-scope mix-up").
 *
 * 🔴 TODA ruta pública (fuera del grupo `mk.auth`) lleva un throttle con
 * prefijo propio: `throttle:{limite},{minutos},{scope}-{endpoint}`, con los
 * límites de `mk_director.auth.rate_limits.*`. El prefijo NO es decorado:
 * `ThrottleRequests` no mete la ruta en la clave, así que sin él todos los
 * endpoints de todos los scopes comparten un contador por IP. Si agregás una
 * ruta pública, dale el suyo.
 */

// El prefijo incluye `api/`: `loadRoutesFrom` desde un ServiceProvider no hereda
// el `apiPrefix` de `bootstrap/app.php`, que sólo aplica a `routes/api.php`.
Route::prefix('api/{{moduleNameLower}}/auth')->group(function () {
    // ── Públicas ────────────────────────────────────────────────────
    Route::post('login', [AuthController::class, 'login']){{rbacLoginThrottle}};
    Route::post('refresh', [AuthController::class, 'refresh']){{refreshThrottle}};
    {{registerRoute}}Route::post('password/forgot', [AuthController::class, 'forgotPassword']){{rbacForgotThrottle}};
    Route::post('password/reset', [AuthController::class, 'resetPassword']){{rbacResetThrottle}};
    // forgot-vía-OTP: variante por PIN de 6 dígitos del reset (públicas, como
    // forgot/reset). Reusan EmailOtpService con purpose='password_reset'.
    Route::post('password/reset/code/request', [AuthController::class, 'requestPasswordResetCode'])
        ->middleware('throttle:'.config('mk_director.auth.rate_limits.password_reset_code_request', '3,10').',{{moduleNameLower}}-reset-code-req');
    Route::post('password/reset/code/confirm', [AuthController::class, 'confirmPasswordResetCode'])
        ->middleware('throttle:'.config('mk_director.auth.rate_limits.password_reset_code_confirm', '5,10').',{{moduleNameLower}}-reset-code-confirm');
{{emailVerifyRoutes}}
    // ── Protegidas (auth: scope) ────────────────────────────────────
    Route::middleware('mk.auth:{{moduleNameLower}}'){{verifiedMiddleware}}->group(function () {
        Route::post('logout', [AuthController::class, 'logout']);
        Route::post('logout-all', [AuthController::class, 'logoutAll']);
        Route::get('me', [AuthController::class, 'me']);
        Route::post('password/change', [AuthController::class, 'changePassword']);
        // Cambio de contraseña con código de un solo uso enviado por email.
        Route::post('password/code/request', [AuthController::class, 'requestPasswordCode'])
            ->middleware('throttle:'.config('mk_director.auth.rate_limits.password_code_request', '3,10').',{{moduleNameLower}}-pwd-code-req');
        Route::post('password/code/confirm', [AuthController::class, 'confirmPasswordCode'])
            ->middleware('throttle:'.config('mk_director.auth.rate_limits.password_code_confirm', '5,10').',{{moduleNameLower}}-pwd-code-confirm');
        {{updateProfileRoute}}
    });
});