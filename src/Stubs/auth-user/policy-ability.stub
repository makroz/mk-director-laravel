<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Policies;

use App\Modules\{{ModuleName}}\Models\{{ModuleName}};
use Mk\Director\Auth\Models\Ability;

/**
 * AbilityPolicy — SÓLO LECTURA.
 *
 * A1/A3: variante del pack `--with-crud`, opera sobre el modelo CENTRAL del
 * paquete `Mk\Director\Auth\Models\Ability`. Las abilities son del sistema:
 * las crea `mk:discover-abilities` y las limpia `mk:prune-abilities`, así que
 * no hay rutas de escritura y `create`/`update`/`delete` retornan `false`. Se
 * asignan con `RoleController::syncAbilities` y `assignDirectAbilities`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 */
class AbilityPolicy
{
    public function before({{ModuleName}} $user, string $ability): ?bool
    {
        return $user->hasRole('super-admin') ? true : null;
    }

    public function viewAny({{ModuleName}} $user): bool
    {
        return $user->canMk('{{moduleNameLower}}.abilities.viewAny');
    }

    public function view({{ModuleName}} $user, Ability $ability): bool
    {
        return $user->canMk('{{moduleNameLower}}.abilities.view');
    }

    public function create({{ModuleName}} $user): bool
    {
        // Default-deny: solo super-admin (via before bypass).
        return false;
    }

    public function update({{ModuleName}} $user, Ability $ability): bool
    {
        return false;
    }

    public function delete({{ModuleName}} $user, Ability $ability): bool
    {
        return false;
    }
}
