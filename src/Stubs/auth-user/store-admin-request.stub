<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;

/**
 * Validación para crear un {{ModuleName}}.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * `name`, `{{loginField}}` y `password` son obligatorios; `{{loginField}}` es
 * único en la tabla. Los profile fields son opcionales salvo que se hayan
 * declarado obligatorios. Para validación propia (un formato de documento, por
 * ejemplo), sobreescribí `rules()`.
 */
class Store{{ModuleName}}Request extends FormRequest
{
    public function authorize(): bool
    {
        return true; // ability check vive en SmartController via $mkConfig + policies.
    }

    /**
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
            'name' => ['required', 'string', 'max:255'],
            '{{loginField}}' => {{loginFieldValidationRuleStore}},
            'password' => ['required', 'string', 'min:8', 'max:255'],
{{fileFieldsValidationStore}}{{profileFieldsUniqueRules}}{{statusRequestRuleStore}}        ];
    }
}