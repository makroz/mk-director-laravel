<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use App\Modules\{{ModuleName}}\Http\Resources\AbilityResource;
use App\Modules\{{ModuleName}}\Services\{{ModuleName}}Service;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Controllers\SmartController;

/**
 * AbilityController — CRUD de abilities del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Las abilities son GLOBALES del paquete (`Mk\Director\Auth\Models\Ability`)
 * y se crean/gestionan vía:
 *   - `mk:discover-abilities` (auto-descubrir desde controllers)
 *   - `{{ModuleName}}Controller::assignDirectAbilities` (asignar a un user)
 *
 * Este controller expone los 5 endpoints estándar. Para policies default-deny,
 * override en `App\Modules\{{ModuleName}}\Policies\AbilityPolicy` (si la generás
 * via `mk:module --with-rbac` por separado).
 *
 * `with` y `allowedIncludes` van vacíos: `Ability` no tiene relación `roles()`,
 * y declararla haría fallar el listado.
 */
class AbilityController extends SmartController
{
    /**
     * @var array<string, mixed>
     */
    protected array $mkConfig = [
        'model'           => Ability::class,
        // `Ability` es un modelo del paquete: el Resource del módulo se declara acá.
        'resource'        => \App\Modules\{{ModuleName}}\Http\Resources\AbilityResource::class,
        'service'         => {{ModuleName}}Service::class,
        'searchable'      => ['name', 'description'],
        'with'            => [],
        'allowedIncludes' => [],
        'features'        => [
            'auto_cache' => true,
            'remember_state' => true,
        ],
    ];

    public function __construct()
    {
        $this->middleware('mk.auth:{{moduleNameLower}}');
    }

    /**
     * POST /api/{{moduleNameLower}}/abilities
     *
     * Crea abilities con naming `{scope}.{recurso}[.{accion}]`. Según la cantidad
     * de segmentos del `name`:
     *   - `{{moduleNameLower}}.{recurso}` (2 segmentos, SIN acción) → EXPANDE a
     *     las 5 abilities CRUD estándar del recurso: `.viewAny`, `.view`,
     *     `.create`, `.update`, `.delete` (idempotente).
     *   - `{{moduleNameLower}}.{recurso}.{accion}` (3 segmentos) → crea SOLO esa.
     *
     * El UI compone `name` como `{scope}.{recurso}` (el scope se prepende), así
     * que el usuario solo tipea el recurso (o `recurso.accion`).
     */
    public function store(Request $request)
    {
        $request->validate([
            'name' => ['required', 'string', 'regex:/^{{moduleNameLower}}\.[A-Za-z][A-Za-z0-9_-]*(\.[A-Za-z][A-Za-z0-9_-]*)?$/'],
        ]);

        $parts = explode('.', trim((string) $request->input('name')));

        // 2 segmentos = `{scope}.{recurso}` → expandir a las 5 CRUD.
        if (count($parts) === 2) {
            return $this->storeCrudSet($parts[0], $parts[1]);
        }

        // 3 segmentos = `{scope}.{recurso}.{accion}` → single.
        return parent::store($request);
    }

    /**
     * Crea las 5 abilities CRUD estándar de un recurso (`{scope}.{recurso}.{verbo}`)
     * de forma idempotente y transaccional. Mismo naming + descripciones que
     * `mk:discover-abilities`.
     */
    private function storeCrudSet(string $scope, string $resource): JsonResponse
    {
        $verbs = ['viewAny', 'view', 'create', 'update', 'delete'];

        $abilities = DB::transaction(function () use ($scope, $resource, $verbs): array {
            $created = [];
            foreach ($verbs as $verb) {
                $created[] = Ability::firstOrCreate(
                    ['name' => "{$scope}.{$resource}.{$verb}"],
                    ['description' => ucfirst($verb).' '.$resource.'.'],
                );
            }

            return $created;
        });

        $new = collect($abilities)->filter->wasRecentlyCreated->count();
        $existed = count($abilities) - $new;
        $message = $existed === 0
            ? "{$new} abilities creadas."
            : "{$new} creadas, {$existed} ya existían.";

        return $this->sendResponse(AbilityResource::collection($abilities), $message, 201);
    }
}