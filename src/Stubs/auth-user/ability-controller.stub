<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use Illuminate\Http\Request;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Controllers\SmartController;

/**
 * AbilityController — abilities del scope `{{moduleNameLower}}`, SÓLO LECTURA.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Las abilities son del SISTEMA: las crea `mk:discover-abilities` leyendo el
 * código y las limpia `mk:prune-abilities`. Una creada a mano no sirve —ninguna
 * ruta la exige— y renombrar o borrar una le cambia el permiso a todos los que
 * la tienen. Por eso este controller sólo lista y muestra (`index`, `show`,
 * con `{scope}.abilities.viewAny` / `.view`), y `store`, `update` y `destroy`
 * responden 405 aunque alguien les agregue una ruta.
 *
 * Asignarlas sigue igual: a un rol con `RoleController::syncAbilities` y a un
 * usuario con `{{ModuleName}}Controller::assignDirectAbilities`.
 *
 * `with` y `allowedIncludes` van vacíos: `Ability` no tiene relación `roles()`,
 * y declararla haría fallar el listado.
 */
class AbilityController extends SmartController
{
    /**
     * @var array<string, mixed>
     */
    protected array $mkConfig = [
        'model'           => Ability::class,
        // `Ability` es un modelo del paquete: el Resource del módulo se declara acá.
        'resource'        => \App\Modules\{{ModuleName}}\Http\Resources\AbilityResource::class,
        // SIN `service`, a propósito: el Service del módulo es el de los
        // USUARIOS, y sus hooks (`beforeUpdate` con `AccessGrantGuard`) buscan un
        // usuario con el `$id` que les llega. Acá ese id es de una ABILITY: un entero
        // contra un uuid, 500 en Postgres.
        'searchable'      => ['name', 'description'],
        'with'            => [],
        'allowedIncludes' => [],
        'features'        => [
            'auto_cache' => true,
            'remember_state' => true,
        ],
    ];

    public function __construct()
    {
        $this->middleware('mk.auth:{{moduleNameLower}}');
    }

    public function store(Request $request)
    {
        $this->refuseWrite();
    }

    public function update(Request $request, string|int $id)
    {
        $this->refuseWrite();
    }

    public function destroy(Request $request, string|int $id)
    {
        $this->refuseWrite();
    }

    private function refuseWrite(): never
    {
        abort(405, 'Las abilities las crea el sistema (mk:discover-abilities): no se crean, editan ni borran a mano.');
    }
}
