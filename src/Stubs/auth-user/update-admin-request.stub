<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Validation\Rule;

/**
 * Validación para actualizar un {{ModuleName}} (partial update).
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Todos los campos son `sometimes` — solo se actualiza lo que viene.
 * `{{loginField}}` y profile fields con `unique` validan IGNORANDO el row actual.
 */
class Update{{ModuleName}}Request extends FormRequest
{
    public function authorize(): bool
    {
        return true;
    }

    /**
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        $id = $this->route('{{moduleNameLower}}')?->id ?? $this->route('{{moduleNameLower}}');

        return [
            'name' => ['sometimes', 'required', 'string', 'max:255'],
            '{{loginField}}' => ['sometimes', 'required', {{loginFieldValidationRuleUpdate}}, Rule::unique('{{moduleNamePluralLower}}', '{{loginField}}')->ignore($id)],
            'password' => ['sometimes', 'nullable', 'string', 'min:8', 'max:255'],
{{fileFieldsValidationUpdate}}{{profileFieldsUniqueRulesUpdate}}{{statusRequestRuleUpdate}}        ];
    }
}