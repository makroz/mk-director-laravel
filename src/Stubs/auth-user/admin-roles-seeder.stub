<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Auth\Models\Role;

/**
 * Seeder de roles predefinidos del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}} --with-crud` (R-PKG-014).
 *
 * Crea 4 roles con jerarquía:
 *   - super-admin: ability `*` (bypass total)
 *   - admin: CRUD completo sobre TODOS los recursos ruteados
 *            ({{moduleNamePluralLower}} + roles + abilities)
 *   - editor: view + update sobre {{moduleNamePluralLower}} (no gestiona RBAC)
 *   - viewer: solo view (read-only) sobre todos los recursos
 *
 * Override este seeder para customizar la jerarquía de roles.
 */
class {{ModuleName}}RolesSeeder extends Seeder
{
    public function run(): void
    {
        $scope = '{{moduleNameLower}}';

        // FEEDBACK A7: el scaffolder --with-crud rutea TRES recursos —
        // el propio módulo + `roles` + `abilities` (RoleController /
        // AbilityController), cada uno gateado con `mk.ability:{scope}.{resource}.*`.
        // Si el seeder solo concede `{{moduleNamePluralLower}}`, el rol `admin`
        // recibe 403 en /roles y /abilities (solo el wildcard de super-admin
        // funcionaba). Concedemos los tres al `admin`, y read-only al `viewer`.
        $resources = ['{{moduleNamePluralLower}}', 'roles', 'abilities'];

        // ── super-admin ─────────────────────────────────────────────────
        $superAdmin = Role::query()->updateOrCreate(
            ['name' => 'super-admin'],
            // R-PKG-015 BUG-NEW-04: la tabla `roles` del paquete solo tiene `id, name,
            // guard, timestamps`. NO tiene `description`. Quitamos del stub. Si el
            // consumer quiere `description`, agrega una migration custom al paquete.
            ['guard' => $scope],
        );
        $this->attachAbility($superAdmin, '*', 'Wildcard: todas las abilities.');

        // ── admin: CRUD completo sobre los tres recursos ────────────────
        $admin = Role::query()->updateOrCreate(
            ['name' => 'admin'],
            ['guard' => $scope],
        );
        foreach ($resources as $resource) {
            foreach (['viewAny', 'view', 'create', 'update', 'delete'] as $action) {
                $this->attachAbility($admin, "{$scope}.{$resource}.{$action}", ucfirst($action).' '.$resource.'.');
            }
        }

        // ── editor: view + update sobre el módulo (no gestiona RBAC) ─────
        $editor = Role::query()->updateOrCreate(
            ['name' => 'editor'],
            ['guard' => $scope],
        );
        foreach (['viewAny', 'view', 'update'] as $action) {
            $this->attachAbility($editor, "{$scope}.{{moduleNamePluralLower}}.{$action}", ucfirst($action).' {{moduleNamePluralLower}}.');
        }

        // ── viewer: read-only sobre los tres recursos ───────────────────
        $viewer = Role::query()->updateOrCreate(
            ['name' => 'viewer'],
            ['guard' => $scope],
        );
        foreach ($resources as $resource) {
            foreach (['viewAny', 'view'] as $action) {
                $this->attachAbility($viewer, "{$scope}.{$resource}.{$action}", ucfirst($action).' '.$resource.'.');
            }
        }
    }

    /**
     * Helper: crea la ability si no existe y la vincula al role via `ability_role` pivot.
     */
    protected function attachAbility(Role $role, string $name, ?string $description = null): void
    {
        $ability = Ability::query()->updateOrCreate(
            ['name' => $name],
            // R-PKG-015 BUG-NEW-03: la tabla `abilities` del paquete solo tiene
            // `id, name, description, timestamps`. NO tiene `module`. Quitamos del
            // stub. Si el consumer quiere `module`, agrega una migration custom.
            ['description' => $description],
        );

        DB::table('ability_role')->updateOrInsert(
            ['role_id' => $role->id, 'ability_id' => $ability->id],
        );
    }
}