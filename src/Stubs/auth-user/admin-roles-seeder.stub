<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Database\Seeders;

use App\Modules\{{ModuleName}}\Enums\CrudAction;
use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Mk\Director\Auth\Enums\FixedStatus;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Auth\Models\Role;

/**
 * Seeder de roles predefinidos del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Crea 4 roles con jerarquía:
 *   - super-admin: ability `*` (bypass total)
 *   - admin: CRUD completo sobre TODOS los recursos ruteados
 *            ({{moduleNamePluralLower}} + roles + abilities)
 *   - editor: view + update sobre {{moduleNamePluralLower}} (no gestiona RBAC)
 *   - viewer: solo view (read-only) sobre todos los recursos
 *
 * Override este seeder para customizar la jerarquía de roles.
 */
class {{ModuleName}}RolesSeeder extends Seeder
{
    public function run(): void
    {
        $scope = '{{moduleNameLower}}';

        // El CRUD generado rutea TRES recursos —
        // el propio módulo + `roles` + `abilities` (RoleController /
        // AbilityController), cada uno gateado con `mk.ability:{scope}.{resource}.*`.
        // Si el seeder solo concede `{{moduleNamePluralLower}}`, el rol `admin`
        // recibe 403 en /roles y /abilities (solo el wildcard de super-admin
        // funcionaba). Concedemos los tres al `admin`, y read-only al `viewer`.
        $resources = ['{{moduleNamePluralLower}}', 'roles', 'abilities'];

        // ── super-admin ─────────────────────────────────────────────────
        // El match incluye `guard` (= scope), no sólo `name`: los nombres
        // (super-admin/admin/editor/viewer) se repiten entre scopes, y matchear
        // por nombre a secas pisaría el guard de los roles de OTRO scope. Va de
        // la mano con el unique (name, guard) de la tabla `roles`.
        $superAdmin = Role::query()->updateOrCreate(
            ['name' => 'super-admin', 'guard' => $scope],
            ['is_fixed' => FixedStatus::Fixed->value],
        );
        $this->attachAbility($superAdmin, '*', 'Wildcard: todas las abilities.', true);

        // ── admin: CRUD completo sobre los tres recursos ────────────────
        $admin = Role::query()->updateOrCreate(
            ['name' => 'admin', 'guard' => $scope],
            [],
        );
        foreach ($resources as $resource) {
            // Acciones desde el enum `CrudAction` (fuente única).
            foreach (CrudAction::all() as $action) {
                $this->attachAbility($admin, "{$scope}.{$resource}.{$action}", ucfirst($action).' '.$resource.'.');
            }
        }

        // ── editor: view + update sobre el módulo (no gestiona RBAC) ─────
        $editor = Role::query()->updateOrCreate(
            ['name' => 'editor', 'guard' => $scope],
            [],
        );
        foreach (['viewAny', 'view', 'update'] as $action) {
            $this->attachAbility($editor, "{$scope}.{{moduleNamePluralLower}}.{$action}", ucfirst($action).' {{moduleNamePluralLower}}.');
        }

        // ── viewer: read-only sobre los tres recursos ───────────────────
        $viewer = Role::query()->updateOrCreate(
            ['name' => 'viewer', 'guard' => $scope],
            [],
        );
        foreach ($resources as $resource) {
            foreach (['viewAny', 'view'] as $action) {
                $this->attachAbility($viewer, "{$scope}.{$resource}.{$action}", ucfirst($action).' '.$resource.'.');
            }
        }

        // ── base: la línea de base del scope ────────────────────────────
        //
        // Los cuatro roles de arriba son de GESTIÓN: se asignan a mano, a quien
        // corresponda. Éste es distinto — lo recibe TODO usuario del scope al
        // nacer, vía el trait `AssignsBaseRole` del modelo. Junta lo que puede
        // hacer cualquiera por el solo hecho de estar logueado: ver su perfil,
        // cambiarse la clave.
        //
        // 🔴 ACÁ SE CREA VACÍO Y ESO ESTÁ BIEN. Sus abilities NO se siembran:
        // las pone `php artisan mk:discover-abilities` leyendo los
        // `#[Ability(..., baseline: true)]` del código, y las mantiene (agrega
        // las nuevas, saca las que perdieron el flag). Sembrarlas acá sería
        // partir el contrato en dos lugares — el seeder y los controllers — y
        // esa es exactamente la forma que se desincroniza sin que nadie lo note.
        //
        // 🔴 SÍ, EL DISCOVERY HACE LO CONTRARIO — Y LOS DOS TIENEN RAZÓN.
        //
        // `mk:discover-abilities` se niega a crear un rol base vacío, porque
        // corre sobre TODOS los scopes de TODOS los consumidores: dejaría un rol
        // sin permisos colgando en proyectos que ni saben de la feature.
        //
        // Acá es al revés. Este seeder es de UN scope que alguien scaffoldeó, y
        // el modelo de ese scope viene con `AssignsBaseRole`. La pregunta es qué
        // pasa con los usuarios creados ANTES de la primera corrida del
        // discovery:
        //
        //   - Si el rol existe desde el día uno, todos lo tienen, y el día que
        //     el discovery le meta las baseline, TODOS las reciben — el permiso
        //     vive en el rol, no copiado en cada usuario.
        //   - Si no existe, el trait es no-op y esa camada queda afuera PARA
        //     SIEMPRE, sin ningún rastro de por qué. Hay que salir a asignarles
        //     el rol a mano, si alguien se da cuenta.
        //
        // Un rol vacío de más se ve y se explica. Un grupo de usuarios sin sus
        // permisos, y sin nada que lo delate, es la clase de bug que se descubre
        // por un ticket de soporte tres meses después.
        Role::query()->updateOrCreate(
            ['name' => config('mk_director.auth.base_role', 'base'), 'guard' => $scope],
            ['is_fixed' => FixedStatus::Fixed->value],
        );
    }

    /**
     * Helper: crea la ability si no existe y la vincula al role via `ability_role` pivot.
     */
    protected function attachAbility(Role $role, string $name, ?string $description = null, bool $isFixed = false): void
    {
        $ability = Ability::query()->updateOrCreate(
            ['name' => $name],
            ['description' => $description, 'is_fixed' => $isFixed ? FixedStatus::Fixed->value : FixedStatus::Editable->value],
        );

        DB::table('ability_role')->updateOrInsert(
            ['role_id' => $role->id, 'ability_id' => $ability->id],
        );
    }
}