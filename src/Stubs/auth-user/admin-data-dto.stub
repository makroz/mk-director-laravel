<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\DTOs;

use Illuminate\Http\Request;

/**
 * DTO inmutable para los datos de un {{ModuleName}}.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Se construye desde:
 *   - `fromRequest()` para input HTTP (create/update)
 *   - `fromArray()` para hidratación desde DB o fixtures de tests
 *
 * `final readonly` — no mutar. Si necesitás cambiar un valor, creá una nueva instancia.
 *
 * Los tres métodos de mapeo cubren todos los profile fields del scope. Los de
 * archivo se guardan como `?string` (la ruta, no el `UploadedFile`): el upload
 * lo procesa el Service o el `FileStoragePlugin`.
 */
final readonly class {{ModuleName}}Data
{
    public function __construct(
        public string $name,
        public string ${{loginField}},
        public ?string $password = null,
{{profileFieldsFillable}}{{statusDtoParam}}    ) {}

    /**
     * Construye desde un Request HTTP. Los file fields declarados via `:file`
     * suffix (e.g. `avatar:file`) pueden venir como `UploadedFile` (multipart)
     * o string path (JSON). El Service procesa el upload, no este método.
     */
    public static function fromRequest(Request $request): self
    {
        return new self(
            name: (string) $request->input('name'),
            {{loginField}}: (string) $request->input('{{loginField}}'),
            password: $request->input('password'),
{{profileFieldsFromRequest}}{{statusDtoFromRequest}}        );
    }

    /**
     * Construye desde un array (hidratación desde DB o fixtures).
     */
    public static function fromArray(array $data): self
    {
        return new self(
            name: (string) ($data['name'] ?? ''),
            {{loginField}}: (string) ($data['{{loginField}}'] ?? ''),
            password: $data['password'] ?? null,
{{profileFieldsFromArray}}{{statusDtoFromArray}}        );
    }

    /**
     * Convierte a array para persistencia. Excluye los file fields como
     * `UploadedFile` (lo maneja el Service). Si el file field ya está como
     * string path (post-upload), se incluye en el output.
     *
     * @return array<string, mixed>
     */
    public function toArray(): array
    {
        return array_filter([
            'name' => $this->name,
            '{{loginField}}' => $this->{{loginField}},
            'password' => $this->password,
{{profileFieldsToArray}}{{statusDtoToArray}}        ], fn ($v) => $v !== null);
    }
}