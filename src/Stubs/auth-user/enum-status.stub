<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Enums;

use Mk\Director\Auth\Enums\ScopeStatus;

/**
 * {{ModuleName}}Status — thin wrapper per-scope que extiende el enum canónico
 * `ScopeStatus` (R-PKG-047 D4).
 *
 * ============================================================
 *  Patrón R-PKG-038 + R-PKG-047 D4
 * ============================================================
 *
 * Pre-D4, este enum era int-backed configurable (`--status-values` flag,
 * valores 1..N asignados en orden). Drift entre scopes + flag extra +
 * hardcoded values 1..4 + fail-fast contra typos = fricción operacional.
 *
 * Post-D4 (R-PKG-047), el paquete expone UN enum canónico `ScopeStatus`
 * (string-backed, 4 estados pineados por la agencia: Active / Inactive /
 * Blocked / Pending). Este thin wrapper pinea los 4 casos del canónico
 * con `value = ScopeStatus::{case}->value` para preservar BC de consumers
 * que pinean `use App\Modules\Admin\Enums\AdminStatus;` directo.
 *
 * Los thin wrappers pineados por el scaffolder pinean SOLO los 4 estados
 * canónicos — NO se pinean cases custom. Para agregar un estado custom
 * (e.g. `Guest`, `Archived`), override post-scaffold este archivo agregando
 * cases manuales y override `canAuthenticate()` si necesitás.
 *
 * ============================================================
 *  Compat / BC
 * ============================================================
 *
 * - **Pre-D4 int-backed**: este wrapper pinea los mismos 4 valores
 *   como STRING (Active='active', etc.) en vez de INT. Consumers pre-D4
 *   que pineaban `match($status->value) { 1 => ... }` deben migrar a
 *   `match($status) { AdminStatus::Active => ... }`. BC break aceptable
 *   per R-G-033 (RETO regenera + clean rebuild). Para scopes pre-D4 que
 *   pineaban `is_active` boolean, `php artisan mk:migrate-is-active {Scope}`
 *   convierte la data en su lugar.
 *
 * - **`canAuthenticate()`**: pre-D4 no existía. Post-D4: solo `Active`
 *   retorna true (gate default del BaseAuthController::userHasValidStatus()).
 *
 * - **`values()` y `default()`**: pre-D4 retornaban int[] 1..N. Post-D4:
 *   string[] (los 4 values canónicos en orden Active/Inactive/Blocked/Pending).
 *
 * - **Drop de `--status-values` flag** (R-PKG-047 D2): los 4 estados son
 *   pineados forzosamente — no hay opción de configurar otros. Override
 *   post-scaffold si necesitás un set custom.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}` post-R-PKG-047
 * (D2 default ON + D4 ScopeStatus enum). El scaffolder ya no acepta
 * `--with-status` / `--status-values` — status es siempre pineado.
 */
enum {{ModuleName}}Status: string
{
    case Active   = 'active';
    case Inactive = 'inactive';
    case Blocked  = 'blocked';
    case Pending  = 'pending';

    /**
     * Estado por default al crear un `{{moduleNameLower}}` nuevo.
     * FEEDBACK10 (F10-B09): retorna `self::Active` (no `ScopeStatus::Active`,
     * clase distinta — el return type es `self`, retornar el enum canónico
     * causaba `TypeError: return value must be of type self, ScopeStatus
     * returned` en cualquier factory/seeder que invoque `{{ModuleName}}Status::default()`).
     */
    public static function default(): self
    {
        return self::Active;
    }

    /**
     * Lista de values string canónicos del enum (en orden de declaración).
     * Delega a `ScopeStatus::values()` para mantener UNA source-of-truth.
     *
     * @return array<int, string>
     */
    public static function values(): array
    {
        return ScopeStatus::values();
    }

    /**
     * ¿Este status permite al usuario autenticarse?
     * Solo `Active` retorna true. Override post-scaffold si necesitás
     * un estado custom que también permita auth (e.g. `Guest` read-only).
     */
    public function canAuthenticate(): bool
    {
        return $this === self::Active;
    }

    /**
     * Label human-readable para UI / responses (español default).
     */
    public function label(): string
    {
        return match ($this) {
            self::Active   => 'Activo',
            self::Inactive => 'Inactivo',
            self::Blocked  => 'Bloqueado',
            self::Pending  => 'Pendiente',
        };
    }
}

