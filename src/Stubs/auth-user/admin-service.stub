use Mk\Director\Auth\Models\Ability;
use Mk\Director\Auth\Models\Role;

/**
 * Service de {{ModuleName}} — capa de orquestación thin.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}} --with-crud` (R-PKG-014).
 *
 * R-PKG-052 T9 (FEEDBACK11) — el Service es ahora **achicado**: solo conserva
 * los métodos que NO son trivialmente delegables al Repository.
 *
 *   - `mutateData()` — hook compartido create+update. Pine file fields upload
 *     pipeline via `{{fileFieldsUploadPipeline}}` (post-R-PKG-050). Override
 *     para lógica custom (e.g. validar dimensiones de un avatar). Se ejecuta
 *     en `create()` y `update()`.
 *   - `syncRoleAbilities(Role, array)` — query + sync de abilities de un Role.
 *     Específico de Admin/Member (no está en CRUDSmart). El controller
 *     lo invoca vía `app({{ModuleName}}Service::class)->syncRoleAbilities($role, ...)`.
 *
 * Métodos ELIMINADOS en R-PKG-052 T9 (eran thin wrappers del Repository):
 *
 *   - ~~`syncRoles($model, $names)`~~ — el controller ahora delega directo al
 *     Repository via `app({{ModuleName}}Repository::class)->syncRoles(...)`.
 *     Sin valor agregado en el Service.
 *   - ~~`syncDirectAbilities($model, $names)`~~ — idem.
 *
 * Trade-off: si el consumer pine override custom de `syncRoles` en
 * AdminService (e.g. logging, events, validaciones), debe moverlo a un
 * event listener o al Repository. R-G-033 dogfooding-first: RETO es
 * único consumer y regenera desde 0 post-merge per R-PKG-051 strategy.
 *
 * FEEDBACK10 (R-PKG-050, Mario 2026-07-10): este stub pinea `mutateData()` y
 * `update()` con signature canónica hardcoded. Los placeholders
 * `{{fileFieldsUploadPipeline}}` y `{{fileFieldsDeleteOldPipeline}}` se
 * generan dinámicamente desde los `:file` suffix de `--profile-fields`
 * (e.g. `avatar:file` → columna `avatar`, accessor `getAvatarUrlAttribute`,
 * plugin config `fields: ['avatar' => 'avatar']`). Si NO hay file fields,
 * los placeholders quedan como string vacío (passthrough).
 */
class {{ModuleName}}Service
{
    public function __construct(
        protected {{ModuleName}}RepositoryInterface $repository,
    ) {}

    /**
     * Crea un {{ModuleName}} con la pipeline completa (mutateData → Repository).
     */
    public function create(array $data): {{ModuleName}}
    {
        return $this->repository->create($this->mutateData($data));
    }

    /**
     * Hook compartido entre create + update. Procesa el upload de los
     * file fields declarados via `--profile-fields="avatar:file,cover:file"`.
     *
     * FEEDBACK10 (R-PKG-050, Mario 2026-07-10): el cuerpo del método se
     * genera dinámicamente desde `{{fileFieldsUploadPipeline}}` (identity
     * map: `avatar` no `avatar_path`). Si no hay file fields, el cuerpo
     * es passthrough.
     *
     * NOTA — R-PKG-027 PKG-NEW-02 fix: el hash de password NO se hace acá.
     * El modelo base `AuthUser` declara `'password' => 'hashed'` en `$casts`
     * (vía `Illuminate\Foundation\Auth\User`), así que Eloquent hashea
     * automáticamente al asignar `$user->password = 'plain'`. Hashear dos
     * veces (acá + cast) producía `bcrypt(bcrypt(plain))`. El rename
     * `beforeCreate` → `mutateData` evita la sugerencia de que el método es
     * solo para create.
     *
     * @param  array<string, mixed>  $data
     * @return array<string, mixed>  Datos mutados.
     */
    protected function mutateData(array $data): array
    {
{{fileFieldsUploadPipeline}}
        return $data;
    }

    /**
     * Actualiza un {{ModuleName}}. Override `mutateData()` para lógica custom
     * (se ejecuta en create + update).
     */
    public function update({{ModuleName}} ${{moduleNameLower}}, array $data): {{ModuleName}}
    {
{{fileFieldsDeleteOldPipeline}}
        $data = $this->mutateData($data); // Reusa la lógica de upload. Password hash via cast.

        return $this->repository->update(${{moduleNameLower}}, $data);
    }

    /**
     * Sincroniza abilities de un Role (específico de Admin/Member, NO está
     * en CRUDSmart).
     *
     * El controller invoca este método cuando se quiere asignar abilities
     * a un role específico (no al user directamente). Pine `Role::query()
     * ->whereIn('name', $abilityNames)->pluck('id')` + `sync()`.
     *
     * @param  array<int, string>  $abilityNames
     */
    public function syncRoleAbilities(Role $role, array $abilityNames): Role
    {
        $abilities = Ability::query()->whereIn('name', $abilityNames)->pluck('id');
        $role->abilities()->sync($abilities);

        return $role->fresh(['abilities']);
    }
}