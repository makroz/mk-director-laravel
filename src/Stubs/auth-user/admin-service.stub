     * map: `avatar` no `avatar_path`). Si no hay file fields, el cuerpo
     * es passthrough.
     *
     * NOTA — R-PKG-027 PKG-NEW-02 fix: el hash de password NO se hace acá.
     * El modelo base `AuthUser` declara `'password' => 'hashed'` en `$casts`
     * (vía `Illuminate\Foundation\Auth\User`), así que Eloquent hashea
     * automáticamente al asignar `$user->password = 'plain'`. Hashear dos
     * veces (acá + cast) producía `bcrypt(bcrypt(plain))`. El rename
     * `beforeCreate` → `mutateData` evita la sugerencia de que el método es
     * solo para create.
     *
     * @param  array<string, mixed>  $data
     * @return array<string, mixed>  Datos mutados.
     */
    protected function mutateData(array $data): array
    {
{{fileFieldsUploadPipeline}}
        return $data;
    }

    /**
     * Actualiza un {{ModuleName}}. Override `mutateData()` para lógica custom
     * (se ejecuta en create + update).
     */
    public function update({{ModuleName}} ${{moduleNameLower}}, array $data): {{ModuleName}}
    {
{{fileFieldsDeleteOldPipeline}}
        $data = $this->mutateData($data); // Reusa la lógica de upload. Password hash via cast.

        return $this->repository->update(${{moduleNameLower}}, $data);
    }

    /**
     * Sincroniza roles (delegado al Repository).
     *
     * @param  array<int, string>  $roleNames
     */
    public function syncRoles({{ModuleName}} ${{moduleNameLower}}, array $roleNames): {{ModuleName}}
    {
        return $this->repository->syncRoles(${{moduleNameLower}}, $roleNames);
