<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Services;

use App\Modules\{{ModuleName}}\Models\{{ModuleName}};
use App\Modules\{{ModuleName}}\Repositories\Contracts\{{ModuleName}}RepositoryInterface;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Http\Request;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Auth\Models\Role;
use Mk\Director\Contracts\MkModuleServiceInterface;

/**
 * Service de {{ModuleName}} — hook layer del módulo.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}} --with-crud` (R-PKG-014).
 *
 * R-PKG-052 T9 v2 (FEEDBACK11, Mario 2026-07-11) — el Service es un **hook
 * layer puro** que delega TODO el trabajo de create/update/delete al
 * CRUDSmart canónico del paquete. NO pine create/update propios,
 * NO pine mutateData con file fields upload pipeline — el FileStoragePlugin
 * se invoca automáticamente desde CRUDSmart via PluginManager.
 *
 * ## ¿Por qué NO pineamos create/update?
 *
 * El `AdminController extends SmartController` ya hereda
 * `CRUDSmart::store()`/`update()`/`destroy()` canónicos. Esos métodos
 * ya hacen TODO el pipeline (R-PKG-016):
 *
 *   1. Resolve FormRequest (R-PKG-046 F9-B08)
 *   2. `fireBeforeSave($request, $input, 'create'|'update')` ← PluginManager
 *      → `FileStoragePlugin::beforeSave()` procesa uploads (avatar, cover_photo, etc.)
 *   3. `service->beforeCreate($request, $input)` ← ESTE hook (lógica específica)
 *   4. DTO validation (type safety + enum validation)
 *   5. Filter fillable
 *   6. `$model::create($input)` o `$model->update($input)`
 *   7. `service->afterCreate($request, $model, $input)` ← ESTE hook
 *   8. `fireAfterSave($model, $request, 'create'|'update')` ← PluginManager
 *      → `FileStoragePlugin::afterSave()` cleanup o post-processing
 *   9. Cache invalidation
 *  10. `autoTransform` con Resource
 *  11. `fireAfterResponse($data)` ← PluginManager
 *      → `FileStoragePlugin::afterResponse()` logging/audit
 *
 * El `FileStoragePlugin` se invoca automáticamente vía el PluginManager
 * (configurable via `$mkConfig['plugins']['file_storage']` en el controller).
 * Pinear mutateData con file fields upload pipeline en el Service
 * es **duplicar lógica** — el plugin system existe precisamente para esto.
 *
 * ## ¿Qué pineamos entonces?
 *
 * Los hooks `beforeCreate`/`afterCreate`/`beforeUpdate`/`afterUpdate`/
 * `beforeDelete`/`afterDelete` se pinean vacíos (passthrough). El
 * consumer los override con lógica **específica del módulo** (validar
 * dimensiones de un avatar custom, emitir domain events, computar
 * hashes, sincronizar con sistemas externos, etc.).
 *
 * Mantenemos `syncRoleAbilities(Role, array)` que es específico de
 * Admin/Member (query + sync de abilities de un Role, no trivialmente
 * delegable al Repository porque cruza la tabla de roles).
 *
 * ## Trade-offs
 *
 * - Si el consumer pine override custom de `create()`/`update()` en
 *   AdminService (e.g. cross-cutting concern que CRUDSmart no maneja),
 *   debe usar un ServiceProvider / Observer / Event Listener, no el
 *   Service del scaffolder.
 * - El Service se enfoca en **module-specific hooks**, no en orquestación
 *   de CRUD (eso es responsabilidad del paquete, via CRUDSmart + plugins).
 *
 * ## Patrón R-PKG-015 aplicado
 *
 * SSoT del CRUD = CRUDSmart (canónico) + PluginManager (canónico).
 * Service = thin layer de hooks específicos. Repository = thin layer
 * de queries. Controller = thin wrapper que delega a CRUDSmart.
 */
class {{ModuleName}}Service implements MkModuleServiceInterface
{
    public function __construct(
        protected {{ModuleName}}RepositoryInterface $repository,
    ) {}

    // ────────────────────────────────────────────────────────────────────
    // Hooks de CRUDSmart — pine vacíos (passthrough) por default.
    // Override en subclase o via service container binding con lógica
    // específica del módulo (e.g. validar dimensiones de un avatar custom,
    // emitir domain events, computar hashes).
    // ────────────────────────────────────────────────────────────────────

    /**
     * Hook antes de crear. CRUDSmart::store() invoca este método
     * después de `fireBeforeSave` (FileStoragePlugin upload) y ANTES
     * del DTO validation + `Model::create()`.
     *
     * @param  array<string, mixed>  $input  Datos validados por FormRequest.
     * @return array<string, mixed>        Datos mutados (o el mismo $input).
     */
    public function beforeCreate(Request $request, array $input): array
    {
        return $input;
    }

    /**
     * Hook después de crear. CRUDSmart::store() invoca este método
     * después del `Model::create()` y ANTES de `fireAfterSave`.
     *
     * Útil para: emitir domain events, sincronizar datos derivados,
     * logging de auditoría, enviar notificaciones.
     */
    public function afterCreate(Request $request, Model $model, array $input): mixed
    {
        // passthrough — override con lógica específica del módulo.
    }

    /**
     * Hook antes de actualizar. CRUDSmart::update() invoca este método
     * después de `fireBeforeSave` (FileStoragePlugin re-upload) y
     * ANTES del DTO validation + `$model->update()`.
     *
     * @param  string|int  $id
     * @param  array<string, mixed>  $input
     * @return array<string, mixed>
     */
    public function beforeUpdate(Request $request, string|int $id, array $input): array
    {
        return $input;
    }

    /**
     * Hook después de actualizar. CRUDSmart::update() invoca este método
     * después del `$model->update()` y ANTES de `fireAfterSave`.
     *
     * @param  string|int  $id
     */
    public function afterUpdate(Request $request, Model $model, array $input, string|int $id): mixed
    {
        // passthrough — override con lógica específica del módulo.
    }

    /**
     * Hook antes de eliminar. Retornar `false` bloquea el delete.
     */
    public function beforeDelete(Request $request, Model $model, string|int $id): bool
    {
        return true;
    }

    /**
     * Hook después de eliminar.
     */
    public function afterDelete(Request $request, Model $model, string|int $id): mixed
    {
        // passthrough.
    }

    /**
     * Hook antes de listar (modificar query).
     */
    public function beforeList(Request $request, $query)
    {
        return $query;
    }

    /**
     * Hook después de listar (transformar filas).
     */
    public function afterList(Request $request, $data, int $total)
    {
        return $data;
    }

    /**
     * Hook de metadata `__extraData` (e.g. roles disponibles para
     * formularios de creación/edición).
     */
    public function setExtraData(Request $request, $data): array
    {
        return [];
    }

    /**
     * Hook antes de buscar (search).
     */
    public function beforeSearch(Request $request, $query)
    {
        return $query;
    }

    /**
     * Hook antes de show (detail view).
     */
    public function beforeShow(Request $request, Model $model): Model
    {
        return $model;
    }

    // ────────────────────────────────────────────────────────────────────
    // Lógica específica de Admin/Member que NO está en CRUDSmart
    // ────────────────────────────────────────────────────────────────────

    /**
     * Sincroniza abilities de un Role (específico de Admin/Member).
     *
     * Query + sync de abilities vía la pivot. NO está en CRUDSmart
     * (CRUDSmart solo sincroniza al MODEL, no a un Role cross-cutting).
     * El controller invoca este método vía
     * `app({{ModuleName}}Service::class)->syncRoleAbilities($role, $names)`.
     *
     * @param  array<int, string>  $abilityNames
     */
    public function syncRoleAbilities(Role $role, array $abilityNames): Role
    {
        $abilities = Ability::query()->whereIn('name', $abilityNames)->pluck('id');
        $role->abilities()->sync($abilities);

        return $role->fresh(['abilities']);
    }
}
