<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use App\Modules\{{ModuleName}}\Http\Requests\SyncRoleAbilitiesRequest;
use App\Modules\{{ModuleName}}\Services\{{ModuleName}}Service;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Auth\Models\Role;
use Mk\Director\Controllers\SmartController;

/**
 * RoleController — CRUD de roles del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Los roles son GLOBALES del paquete (`Mk\Director\Auth\Models\Role`).
 * El sync de abilities a un role se hace via `syncAbilities()`.
 *
 * No importa modelos de otros módulos.
 */
class RoleController extends SmartController
{
    /**
     * @var array<string, mixed>
     */
    protected array $mkConfig = [
        'model'           => Role::class,
        // `Role` es un modelo del paquete: el Resource del módulo se declara acá.
        'resource'        => \App\Modules\{{ModuleName}}\Http\Resources\RoleResource::class,
        'service'         => {{ModuleName}}Service::class,
        'searchable'      => ['name'],
        'with'            => ['abilities'],
        'allowedIncludes' => ['abilities'],
        'features'        => [
            'auto_cache' => true,
            'remember_state' => true,
        ],
    ];

    public function __construct()
    {
        $this->middleware('mk.auth:{{moduleNameLower}}');
    }

    /**
     * Metadata de dominio para los formularios de creación/edición de roles:
     * la lista de abilities disponibles en el scope `{{moduleNameLower}}`
     * (nombradas `{{moduleNameLower}}.{resource}.{action}`).
     *
     * Se emite bajo `__extraData.abilities`. El front (`useMkList`) la pide con
     * `__extraData=1` SOLO en la primera carga de la lista y la cachea, así el
     * formulario NO repide las abilities cada vez que se abre. Poné
     * `$mkConfig['extraDataForce'] => true` si necesitás que venga en cada request.
     */
    public function setExtraData(Request $request, $data): array
    {
        $scope = '{{moduleNameLower}}';

        return [
            'abilities' => Ability::query()
                ->where('name', 'like', $scope.'.%')
                ->orderBy('name')
                ->get(['id', 'name', 'description']),
        ];
    }

    /**
     * PUT /api/roles/{id}/abilities
     *
     * Sincroniza (reemplaza) las abilities del role. Body: `{"abilities": ["admin.dashboard.view"]}`.
     */
    public function syncAbilities(string $id, SyncRoleAbilitiesRequest $request): JsonResponse
    {
        /** @var Role $role */
        $role = Role::findOrFail($id);

        app({{ModuleName}}Service::class)->syncRoleAbilities($role, $request->validated('abilities'));

        return $this->sendResponse(
            $role->fresh()->load('abilities'),
            'Abilities del role sincronizadas.',
        );
    }
}