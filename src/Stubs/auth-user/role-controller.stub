<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use App\Modules\{{ModuleName}}\Http\Requests\SyncRoleAbilitiesRequest;
use App\Modules\{{ModuleName}}\Services\{{ModuleName}}Service;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Mk\Director\Auth\Access\AccessGrantGuard;
use Mk\Director\Auth\Models\Ability;
use Mk\Director\Auth\Models\Role;
use Mk\Director\Controllers\SmartController;

/**
 * RoleController — CRUD de roles del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Los roles son GLOBALES del paquete (`Mk\Director\Auth\Models\Role`).
 * El sync de abilities a un role se hace via `syncAbilities()`.
 *
 * Editar, borrar o sincronizar un rol pasa por
 * `AccessGrantGuard::assertCanChangeRole()` (403): un rol fijo no se toca,
 * nadie cambia las abilities de un rol que tiene, ni toca el rol de alguien con
 * más acceso, y sólo se agrega o se quita lo que el actor tiene. Si
 * sobreescribís `update()`, `destroy()` o `syncAbilities()`, conservá la llamada.
 *
 * El rol se carga con `findScopedOrFail()`, el mismo lookup del CRUD: con un
 * plugin de tenant, el rol de otro tenant da 404 antes de la guarda. Con un
 * `Role::findOrFail()` pelado daba 403 (y el sync lo escribía).
 *
 * No importa modelos de otros módulos.
 */
class RoleController extends SmartController
{
    /**
     * @var array<string, mixed>
     */
    protected array $mkConfig = [
        'model'           => Role::class,
        // `Role` es un modelo del paquete: el Resource del módulo se declara acá.
        'resource'        => \App\Modules\{{ModuleName}}\Http\Resources\RoleResource::class,
        // SIN `service`, a propósito: el Service del módulo es el de los
        // USUARIOS, y sus hooks (`beforeUpdate` con `AccessGrantGuard`) buscan un
        // usuario con el `$id` que les llega. Acá ese id es de un ROL: un entero
        // contra un uuid, 500 en Postgres. `syncRoleAbilities()` se llama directo.
        'searchable'      => ['name'],
        'with'            => ['abilities'],
        'allowedIncludes' => ['abilities'],
        'features'        => [
            'auto_cache' => true,
            'remember_state' => true,
        ],
    ];

    public function __construct()
    {
        $this->middleware('mk.auth:{{moduleNameLower}}');
    }

    /**
     * Metadata de dominio para los formularios de creación/edición de roles:
     * la lista de abilities disponibles en el scope `{{moduleNameLower}}`
     * (nombradas `{{moduleNameLower}}.{resource}.{action}`).
     *
     * Se emite bajo `__extraData.abilities`. El front (`useMkList`) la pide con
     * `__extraData=1` SOLO en la primera carga de la lista y la cachea, así el
     * formulario NO repide las abilities cada vez que se abre. Poné
     * `$mkConfig['extraDataForce'] => true` si necesitás que venga en cada request.
     */
    public function setExtraData(Request $request, $data): array
    {
        $scope = '{{moduleNameLower}}';

        return [
            'abilities' => Ability::query()
                ->where('name', 'like', $scope.'.%')
                ->orderBy('name')
                ->get(['id', 'name', 'description']),
        ];
    }

    /**
     * `is_fixed` lo pone el sistema (seeders, discovery), nunca el body: el
     * CRUD no lo escribe, ni en el alta ni en la edición. Un rol que alguien
     * marcara fijo desde la UI ya no se podría volver a editar.
     *
     * @return array<int, string>
     */
    protected function getFillable(): array
    {
        return array_values(array_diff(parent::getFillable(), ['is_fixed']));
    }

    /**
     * Editar un rol (su `guard`, por ejemplo) ya es tocar el acceso de quienes lo tienen.
     */
    public function update(Request $request, string|int $id)
    {
        app(AccessGrantGuard::class)->assertCanChangeRole($request->user(), $this->findScopedOrFail($request, $id), null);

        return parent::update($request, $id);
    }

    /**
     * Borrar el rol es sacarles TODAS sus abilities a quienes lo tienen: se
     * controla como un sync a `[]`.
     */
    public function destroy(Request $request, string|int $id)
    {
        app(AccessGrantGuard::class)->assertCanChangeRole($request->user(), $this->findScopedOrFail($request, $id), []);

        return parent::destroy($request, $id);
    }

    /**
     * PUT /api/roles/{id}/abilities
     *
     * Sincroniza (reemplaza) las abilities del role. Body: `{"abilities": ["admin.dashboard.view"]}`.
     */
    public function syncAbilities(string $id, SyncRoleAbilitiesRequest $request): JsonResponse
    {
        /** @var Role $role */
        $role = $this->findScopedOrFail($request, $id);

        app(AccessGrantGuard::class)->assertCanChangeRole($request->user(), $role, $request->validated('abilities'));

        app({{ModuleName}}Service::class)->syncRoleAbilities($role, $request->validated('abilities'));

        return $this->sendResponse(
            $role->fresh()->load('abilities'),
            'Abilities del role sincronizadas.',
        );
    }
}