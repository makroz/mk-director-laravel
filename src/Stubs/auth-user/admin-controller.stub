<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use App\Modules\{{ModuleName}}\Http\Requests\AssignAccessRequest;
use App\Modules\{{ModuleName}}\Http\Requests\AssignRolesRequest;
use App\Modules\{{ModuleName}}\Http\Requests\AssignDirectAbilitiesRequest;
use App\Modules\{{ModuleName}}\Http\Requests\Store{{ModuleName}}Request;
use App\Modules\{{ModuleName}}\Http\Requests\Update{{ModuleName}}Request;
use App\Modules\{{ModuleName}}\Models\{{ModuleName}};
use App\Modules\{{ModuleName}}\Repositories\{{ModuleName}}Repository;
use App\Modules\{{ModuleName}}\Services\{{ModuleName}}Service;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Mk\Director\Auth\Models\Role;
use Mk\Director\Controllers\SmartController;

/**
 * {{ModuleName}}Controller — CRUD estándar del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}} --with-crud` (R-PKG-014).
 * Extiende `SmartController` para el CRUD; los endpoints `assignRoles` /
 * `assignDirectAbilities` son específicos del RBAC del scope (operan sobre
 * las tablas globales del paquete: `roles`, `abilities`, `role_user` con
 * `user_type` polimórfico).
 *
 * **MME (R-MK-001)**: este controller es interno del bounded context
 * `App\Modules\{{ModuleName}}`. NO debe importar modelos de otros módulos.
 *
 * **Permisos**: la authorization se delega a `SmartController` vía `$mkConfig`.
 * Si necesitás abilities custom (e.g. `{{moduleNameLower}}.{{moduleNamePluralLower}}.viewAny`),
 * agregalas a `mk_director.abilities` y el `AbilityResolver` las resolverá.
 */
class {{ModuleName}}Controller extends SmartController
{
    /**
     * @var array<string, mixed>
     */
    protected array $mkConfig = [
        'model'           => {{ModuleName}}::class,
        // HALLAZGO-NEW-FASE17-03 fix: pinear `resource` explícito como BC
        // fallback path. R-PKG-044 v2.0.0 canónico es per-model
        // `public $apiResource` en {{ModuleName}}::class (aplicado por
        // BaseController::autoTransform, see HALLAZGO-NEW-FASE15-07).
        // Este `resource` per-controller se mantiene como BC para
        // `CRUDSmart::autoTransform` (thin wrapper @deprecated).
        // Sin esto, cuando el wrapper delega al canónico y el modelo
        // NO pinea `$apiResource`, `autoTransform()` retorna el Model crudo
        // porque `property_exists()` da false (modelo sin API Resource).
        'resource'        => \App\Modules\{{ModuleName}}\Http\Resources\{{ModuleName}}Resource::class,
        'service'         => {{ModuleName}}Service::class,
        'store_request'   => Store{{ModuleName}}Request::class,
        'update_request'  => Update{{ModuleName}}Request::class,
        // HALLAZGO-NEW-FASE17-04 fix: el stub pineaba
        // `['name', 'full_name', 'email', 'ci']` pero la tabla admins default
        // solo tiene `name` + `email` → mk:status warning. Si el consumer quiere
        // searchable extendido, pinear --profile-fields=full_name,ci al scaffolder.
        'searchable'      => ['name', 'email'],
        'with'            => ['roles', 'directAbilities'],
        'allowedIncludes' => ['roles', 'roles.abilities', 'directAbilities'],
        'features'        => [
            'auto_cache' => true,
            'remember_state' => true,
            // R-PKG whitelist de filtros del list endpoint. `ListManager::applyFilters`
            // IGNORA en silencio cualquier `filter[campo]` que NO esté acá (security
            // whitelist), y si el array está vacío descarta TODOS los filtros. Todo
            // AuthUser scaffoldeado trae la columna `status` (ScopeStatus, D2 ON), así
            // que el filtro `filter[status]=active|inactive|...` — que el front cablea
            // por default en la pantalla de lista — nace vivo. Agregá más campos acá
            // (fillable del scope) si querés exponerlos como filtro.
            'allowed_filters' => ['status'],
        ],

        // R-PKG-047 D3 — auto-wire FileStoragePlugin via `:file` suffix en
        // --profile-fields (e.g. `--profile-fields='avatar:file,phone:string'`).
        //
        // FEEDBACK10 (RETO pilot, 2026-07-13) — el scaffolder pineaba la config
        // bajo UNA sola key `plugins` con shape `['file_storage' => [...]]`. Eso
        // rompía la subida end-to-end por DOS motivos:
        //   1. `FileStoragePlugin` lee su config vía
        //      `getConfigValue('plugins_config.file_storage')` — key `plugins_config`,
        //      NO `plugins`. Bajo `plugins` el `data_get` daba `[]` → el plugin
        //      no procesaba el file y el tmp path del UploadedFile terminaba
        //      persistido en la columna.
        //   2. `CRUDSmart::getPluginManager()` registra `$this->mkConfig['plugins']`
        //      como LISTA DE CLASES (strings). Un array asociativo de config ahí
        //      es skippeado por `PluginManager::registerPlugins()` (F10-B16) →
        //      el plugin no quedaba registrado per-controller.
        //
        // Post-fix: dos keys separadas.
        //   - `plugins`        → lista de clases que CRUDSmart registra per-controller
        //     (así la subida funciona AUNQUE el auto-register global esté off, e.g.
        //     `MK_FILE_STORAGE_PLUGIN=false`).
        //   - `plugins_config` → config por plugin que el plugin lee vía
        //     `getConfigValue('plugins_config.<name>')`.
        // Sin file fields en --profile-fields, ambas quedan `[]`.
        'plugins'         => {{pluginsList}},
        'plugins_config'  => {{pluginsConfig}},
    ];

    /**
     * R-PKG-046 F9-B10 — Constructor vacío.
     *
     * Pre-fix pineaba `$this->middleware('mk.auth:{{moduleNameLower}}')` que
     * se aplicaba a TODAS las acciones del controller, incluyendo cuando se
     * invocaban desde rutas managed (que ya pinean `mk.auth:{{managerNameLower}}`).
     * Combinado con F9-B09 (loadRoutesFrom acumulado), el efecto se duplicaba
     * y un admin token intentando `POST /api/admin/members` fallaba con
     * `ERR_SCOPE_MISMATCH` antes de que `mk.auth:admin` corriera.
     *
     * Post-fix: las rutas per-route (pineadas en `Http/Routes/api.php` y
     * `Http/Routes/managed.php`) ya pinean el middleware correcto per endpoint
     * (`mk.auth:{scope}` + `mk.ability:{scope}.{resource}.{action}`). Defense-in-depth
     * per-route es suficiente — el constructor queda vacío para evitar
     * leak entre controllers reusados cross-scope.
     */
    public function __construct()
    {
        // vacío — defense-in-depth cubierta per-route
    }

    /**
     * Metadata de dominio para los formularios de creación/edición: la lista
     * de roles disponibles en el scope `{{moduleNameLower}}`.
     *
     * Se emite bajo `__extraData.roles`. El front (`useMkList`) la pide con
     * `__extraData=1` SOLO en la primera carga de la lista y la cachea, así el
     * formulario NO repide los roles cada vez que se abre. Poné
     * `$mkConfig['extraDataForce'] => true` si necesitás que venga en cada request.
     */
    public function setExtraData(Request $request, $data): array
    {
        $scope = '{{moduleNameLower}}';

        return [
            // N13 fix: la tabla `roles` del paquete NO tiene `description`
            // (solo id/name/guard/timestamps). Seleccionar `description` acá
            // reventaba con SQLSTATE 42703 en el primer `GET /?__extraData=1`
            // que manda `useMkList` en la carga inicial → la pantalla moría
            // out-of-the-box. Seleccionamos solo las columnas que existen.
            'roles' => Role::query()
                ->where('guard', $scope)
                ->orderBy('name')
                ->get(['id', 'name']),
        ];
    }

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/access
     *
     * Asigna roles + abilities directas en UNA sola operación transaccional.
     * Body: `{"roles": ["editor"], "abilities": ["admin.dashboard.view"]}`.
     *
     * Reemplaza el par `assignRoles` + `assignDirectAbilities` (que forzaba 2
     * requests desde el front y dejaba estado parcial si el 2º fallaba). Reglas:
     *   - `roles`     → requerido (≥1); se sincroniza siempre.
     *   - `abilities` → opcional; si no llega se sincroniza a `[]` (no graba
     *     ninguna directa). Ver {{ModuleName}}\Http\Requests\AssignAccessRequest.
     *
     * Ambos syncs corren dentro de una transacción: si uno falla, ninguno queda
     * a medias (a diferencia de los 2 endpoints separados).
     */
    public function assignAccess(string $id, AssignAccessRequest $request): JsonResponse
    {
        /** @var {{ModuleName}} ${{moduleNameLower}} */
        ${{moduleNameLower}} = {{ModuleName}}::findOrFail($id);

        $repository = app({{ModuleName}}Repository::class);

        DB::transaction(function () use ($repository, ${{moduleNameLower}}, $request): void {
            $repository->syncRoles(${{moduleNameLower}}, $request->validated('roles'));
            // Abilities opcionales: ausencia/null → `[]` → sync a vacío.
            $repository->syncDirectAbilities(${{moduleNameLower}}, $request->validated('abilities') ?? []);
        });

        return $this->sendResponse(
            ${{moduleNameLower}}->fresh()->load(['roles', 'directAbilities']),
            'Accesos actualizados.',
        );
    }

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/roles
     *
     * @deprecated Usá `assignAccess` (`POST /{id}/access`) que sincroniza roles
     * y abilities en una sola transacción. Se mantiene por BC.
     *
     * Asigna roles (por nombre) al {{ModuleName}}. Body: `{"roles": ["admin", "editor"]}`.
     * Sincroniza (reemplaza) los roles existentes.
     */
    public function assignRoles(string $id, AssignRolesRequest $request): JsonResponse
    {
        /** @var {{ModuleName}} ${{moduleNameLower}} */
        ${{moduleNameLower}} = {{ModuleName}}::findOrFail($id);

        // R-PKG-052 T9: delega directo al Repository (pre-T9 pineaba
        // un thin wrapper del Service, que era un delegate trivial).
        // Achicar el Service para que solo contenga lo NO trivialmente
        // delegable (mutateData hook + syncRoleAbilities específico).
        app({{ModuleName}}Repository::class)->syncRoles(${{moduleNameLower}}, $request->validated('roles'));

        return $this->sendResponse(
            ${{moduleNameLower}}->fresh()->load('roles'),
            'Roles asignados.',
        );
    }

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/abilities
     *
     * Asigna abilities directas (bypass role hierarchy). Body: `{"abilities": ["admin.dashboard.view"]}`.
     * Sincroniza las abilities directas del {{ModuleName}}.
     */
    public function assignDirectAbilities(string $id, AssignDirectAbilitiesRequest $request): JsonResponse
    {
        /** @var {{ModuleName}} ${{moduleNameLower}} */
        ${{moduleNameLower}} = {{ModuleName}}::findOrFail($id);

        // R-PKG-052 T9: idem rationale que assignRoles() — delega al
        // Repository directo, sin pasar por el Service.
        app({{ModuleName}}Repository::class)->syncDirectAbilities(${{moduleNameLower}}, $request->validated('abilities'));

        return $this->sendResponse(
            ${{moduleNameLower}}->fresh()->load('directAbilities'),
            'Abilities directas asignadas.',
        );
    }
}