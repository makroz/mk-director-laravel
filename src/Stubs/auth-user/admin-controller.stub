<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Controllers;

use App\Modules\{{ModuleName}}\Http\Requests\AssignAccessRequest;
use App\Modules\{{ModuleName}}\Http\Requests\AssignRolesRequest;
use App\Modules\{{ModuleName}}\Http\Requests\AssignDirectAbilitiesRequest;
use App\Modules\{{ModuleName}}\Http\Requests\Store{{ModuleName}}Request;
use App\Modules\{{ModuleName}}\Http\Requests\Update{{ModuleName}}Request;
use App\Modules\{{ModuleName}}\Models\{{ModuleName}};
use App\Modules\{{ModuleName}}\Repositories\{{ModuleName}}Repository;
use App\Modules\{{ModuleName}}\Services\{{ModuleName}}Service;
use Illuminate\Http\JsonResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Mk\Director\Auth\Models\Role;
use Mk\Director\Controllers\SmartController;

/**
 * {{ModuleName}}Controller — CRUD estándar del scope `{{moduleNameLower}}`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 * Extiende `SmartController` para el CRUD; los endpoints `assignRoles` /
 * `assignDirectAbilities` son específicos del RBAC del scope (operan sobre
 * las tablas globales del paquete: `roles`, `abilities`, `role_user` con
 * `user_type` polimórfico).
 *
 * Es interno del módulo `App\Modules\{{ModuleName}}`: no importa modelos de
 * otros módulos.
 *
 * **Permisos**: la authorization se delega a `SmartController` vía `$mkConfig`.
 * Si necesitás abilities custom (e.g. `{{moduleNameLower}}.{{moduleNamePluralLower}}.viewAny`),
 * agregalas a `mk_director.abilities` y el `AbilityResolver` las resolverá.
 */
class {{ModuleName}}Controller extends SmartController
{
    /**
     * @var array<string, mixed>
     */
    protected array $mkConfig = [
        'model'           => {{ModuleName}}::class,
        // También declarado acá (además de `$apiResource` en el modelo) para
        // que la respuesta salga por el Resource aunque el modelo no lo tenga.
        'resource'        => \App\Modules\{{ModuleName}}\Http\Resources\{{ModuleName}}Resource::class,
        'service'         => {{ModuleName}}Service::class,
        'store_request'   => Store{{ModuleName}}Request::class,
        'update_request'  => Update{{ModuleName}}Request::class,
        // Columnas de texto del scope (nombre, login y profile fields de texto).
        // Si agregás una, que exista en la tabla: una columna inexistente es un
        // 500 de SQL con la primera búsqueda.
        'searchable'      => {{searchableColumns}},
        'with'            => ['roles', 'directAbilities'],
        'allowedIncludes' => ['roles', 'roles.abilities', 'directAbilities'],
        'features'        => [
            'auto_cache' => true,
            'remember_state' => true,
            // Whitelist de filtros del listado: `ListManager::applyFilters` IGNORA
            // en silencio cualquier `filter[campo]` que no esté acá, y con el array
            // vacío descarta TODOS. `status` va porque el front lo filtra por
            // default. Agregá los campos que quieras exponer como filtro.
            'allowed_filters' => ['status'],
        ],

        // Subida de archivos (profile fields `:file`). Dos claves distintas:
        //   - `plugins`        → CLASES que CRUDSmart registra en este controller
        //     (la subida anda aunque el plugin global esté apagado).
        //   - `plugins_config` → la config que cada plugin lee de
        //     `plugins_config.<nombre>`. Bajo `plugins` no la encuentra, y la
        //     ruta temporal del upload terminaría guardada en la columna.
        // Sin file fields, ambas quedan vacías.
        'plugins'         => {{pluginsList}},
        'plugins_config'  => {{pluginsConfig}},
    ];

    /**
     * Sin middleware de constructor, a propósito: la autenticación va POR RUTA
     * (`mk.auth` + `mk.ability` en `Http/Routes/api.php` y `managed.php`). Este
     * controller lo reusan las rutas de otro scope que administra a éste, y un
     * `mk.auth:{{moduleNameLower}}` acá rechazaría el token de ese scope.
     */
    public function __construct()
    {
        // vacío — la autenticación va por ruta
    }

    /**
     * Metadata de dominio para los formularios de creación/edición: la lista
     * de roles disponibles en el scope `{{moduleNameLower}}`.
     *
     * Se emite bajo `__extraData.roles`. El front (`useMkList`) la pide con
     * `__extraData=1` SOLO en la primera carga de la lista y la cachea, así el
     * formulario NO repide los roles cada vez que se abre. Poné
     * `$mkConfig['extraDataForce'] => true` si necesitás que venga en cada request.
     */
    public function setExtraData(Request $request, $data): array
    {
        $scope = '{{moduleNameLower}}';

        return [
            'roles' => Role::query()
                ->where('guard', $scope)
                ->orderBy('name')
                ->get(['id', 'name']),
        ];
    }

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/access
     *
     * Asigna roles + abilities directas en UNA sola operación transaccional.
     * Body: `{"roles": ["editor"], "abilities": ["admin.dashboard.view"]}`.
     *
     * Reemplaza el par `assignRoles` + `assignDirectAbilities` (que forzaba 2
     * requests desde el front y dejaba estado parcial si el 2º fallaba). Reglas:
     *   - `roles`     → requerido (≥1); se sincroniza siempre.
     *   - `abilities` → opcional; si no llega se sincroniza a `[]` (no graba
     *     ninguna directa). Ver {{ModuleName}}\Http\Requests\AssignAccessRequest.
     *
     * Ambos syncs corren dentro de una transacción: si uno falla, ninguno queda
     * a medias (a diferencia de los 2 endpoints separados).
     */
    public function assignAccess(string $id, AssignAccessRequest $request): JsonResponse
    {
        /** @var {{ModuleName}} ${{moduleNameLower}} */
        ${{moduleNameLower}} = {{ModuleName}}::findOrFail($id);

        $repository = app({{ModuleName}}Repository::class);

        DB::transaction(function () use ($repository, ${{moduleNameLower}}, $request): void {
            $repository->syncRoles(${{moduleNameLower}}, $request->validated('roles'));
            // Abilities opcionales: ausencia/null → `[]` → sync a vacío.
            $repository->syncDirectAbilities(${{moduleNameLower}}, $request->validated('abilities') ?? []);
        });

        return $this->sendResponse(
            ${{moduleNameLower}}->fresh()->load(['roles', 'directAbilities']),
            'Accesos actualizados.',
        );
    }

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/roles
     *
     * @deprecated Usá `assignAccess` (`POST /{id}/access`) que sincroniza roles
     * y abilities en una sola transacción. Se mantiene por BC.
     *
     * Asigna roles (por nombre) al {{ModuleName}}. Body: `{"roles": ["admin", "editor"]}`.
     * Sincroniza (reemplaza) los roles existentes.
     */
    public function assignRoles(string $id, AssignRolesRequest $request): JsonResponse
    {
        /** @var {{ModuleName}} ${{moduleNameLower}} */
        ${{moduleNameLower}} = {{ModuleName}}::findOrFail($id);

        app({{ModuleName}}Repository::class)->syncRoles(${{moduleNameLower}}, $request->validated('roles'));

        return $this->sendResponse(
            ${{moduleNameLower}}->fresh()->load('roles'),
            'Roles asignados.',
        );
    }

    /**
     * POST /api/{{moduleNamePluralLower}}/{id}/abilities
     *
     * Asigna abilities directas (bypass role hierarchy). Body: `{"abilities": ["admin.dashboard.view"]}`.
     * Sincroniza las abilities directas del {{ModuleName}}.
     */
    public function assignDirectAbilities(string $id, AssignDirectAbilitiesRequest $request): JsonResponse
    {
        /** @var {{ModuleName}} ${{moduleNameLower}} */
        ${{moduleNameLower}} = {{ModuleName}}::findOrFail($id);

        app({{ModuleName}}Repository::class)->syncDirectAbilities(${{moduleNameLower}}, $request->validated('abilities'));

        return $this->sendResponse(
            ${{moduleNameLower}}->fresh()->load('directAbilities'),
            'Abilities directas asignadas.',
        );
    }
}