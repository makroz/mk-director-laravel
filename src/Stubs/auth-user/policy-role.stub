<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Policies;

use App\Modules\{{ModuleName}}\Models\{{ModuleName}};
use Mk\Director\Auth\Models\Role;

/**
 * RolePolicy — autorización para CRUD de roles + syncAbilities.
 *
 * A1/A3: variante del pack `--with-crud`. A diferencia de `mk:module --with-rbac`
 * (tríada aislada con Role módulo-local), el camino `--with-crud` opera sobre el
 * modelo CENTRAL del paquete `Mk\Director\Auth\Models\Role`. Default-deny +
 * super-admin bypass en `before()`.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}} --with-crud`.
 */
class RolePolicy
{
    public function before({{ModuleName}} $user, string $ability): ?bool
    {
        return $user->hasRole('super-admin') ? true : null;
    }

    public function viewAny({{ModuleName}} $user): bool
    {
        return $user->canMk('{{moduleNameLower}}.roles.viewAny');
    }

    public function view({{ModuleName}} $user, Role $role): bool
    {
        return $user->canMk('{{moduleNameLower}}.roles.view');
    }

    public function create({{ModuleName}} $user): bool
    {
        return $user->canMk('{{moduleNameLower}}.roles.create');
    }

    public function update({{ModuleName}} $user, Role $role): bool
    {
        return $user->canMk('{{moduleNameLower}}.roles.update');
    }

    public function delete({{ModuleName}} $user, Role $role): bool
    {
        return $user->canMk('{{moduleNameLower}}.roles.delete');
    }

    public function syncAbilities({{ModuleName}} $user): bool
    {
        return $user->canMk('{{moduleNameLower}}.roles.syncAbilities');
    }
}
