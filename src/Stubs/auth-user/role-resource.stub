<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Resources;

use Illuminate\Http\Request;
use Illuminate\Http\Resources\Json\JsonResource;
use Mk\Director\Auth\Enums\FixedStatus;

/**
 * Resource para Role.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}} --with-crud` (R-PKG-014).
 * Roles pueden tener abilities asignadas (pivot `ability_role`).
 * Solo se incluyen si están `whenLoaded`.
 */
class RoleResource extends JsonResource
{
    /**
     * @return array<string, mixed>
     */
    public function toArray(Request $request): array
    {
        return [
            'id' => $this->id,
            'name' => $this->name,
            'guard' => $this->guard,
            // FEEDBACK10 F10-B07: `description` REMOVIDO — la tabla `roles`
            // no tiene esa columna (a diferencia de `abilities`, que sí la
            // tiene). Exponerla acá + aceptarla en mass-assignment producía
            // `SQLSTATE[42703] column "description" does not exist` en
            // cualquier create/update de role.
            'is_fixed' => $this->is_fixed instanceof FixedStatus ? $this->is_fixed->value : (int) ($this->is_fixed ?? 0),
            'abilities' => $this->whenLoaded('abilities', fn () => $this->abilities->pluck('name')),
            'created_at' => $this->created_at?->toIso8601String(),
            'updated_at' => $this->updated_at?->toIso8601String(),
        ];
    }
}