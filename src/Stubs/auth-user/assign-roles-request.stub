<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;
use Mk\Director\Auth\Models\Role;

/**
 * Validación para asignar roles (por nombre) a un {{ModuleName}}.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Roles vienen por NOMBRE (no ID) — más portable y friendly para el frontend.
 * Se validan contra los roles existentes en `mk_director`.
 */
class AssignRolesRequest extends FormRequest
{
    public function authorize(): bool
    {
        return true;
    }

    /**
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        // 🔴 SÓLO LOS ROLES DE ESTE GUARD. La tabla `roles` es compartida y los
        // nombres se repiten entre scopes POR DISEÑO: el scaffolder siembra
        // `super-admin`, `admin`, `editor`, `viewer` y `base` en cada guard.
        //
        // Sin el filtro, el nombre de un rol del scope ajeno pasaba el `in:`. Y
        // como el repositorio SÍ filtra por guard, el `sync()` no encontraba nada
        // y BORRABA todos los roles del usuario contestando 200. Un 200 que borra
        // en silencio es peor que la fuga original: la fuga dejaba un
        // `viewer, viewer` visible en la pantalla; esto deja al usuario sin
        // ninguna ability sin que nada lo diga.
        $existingRoleNames = Role::query()
            ->where('guard', '{{moduleNameLower}}')
            ->pluck('name')
            ->all();

        return [
            // `present` (no `required`) para que `{ "roles": [] }`
            // sea válido y se puedan QUITAR todos los roles vía este endpoint.
            // `present` exige la clave en el body pero admite el array vacío;
            // `required` la rechazaba con 422, imposibilitando limpiar.
            'roles' => ['present', 'array'],
            'roles.*' => ['string', 'in:'.implode(',', $existingRoleNames)],
        ];
    }
}