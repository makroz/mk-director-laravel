<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Models;

use Illuminate\Database\Eloquent\Concerns\HasUuids;
{{factoryHasFactoryUse}}{{mustVerifyEmailUse}}{{statusUseImport}}use Mk\Director\Auth\Concerns\AssignsBaseRole;
use Mk\Director\Auth\Models\AuthUser;

/**
 * Usuario del scope de autenticación `{{moduleNameLower}}`.
 *
 * Extiende {@see AuthUser} y queda atado a su scope por la columna
 * `auth_scope`: un token de otro scope no autentica contra este modelo (ver
 * docs/guides/AUTH.md § "The 4 defense layers against cross-scope mix-up").
 *
 * El modelo es interno al módulo `App\Modules\{{ModuleName}}`: otros módulos no
 * lo importan (lo verifica `php artisan mk:lint:boundaries`). Si necesitan datos
 * de un {{moduleNameLower}}, exponelos en `App\Modules\{{ModuleName}}\Api\`.
 *
 * Login por `{{loginField}}`.
{{profileFieldsDocblock}} */
class {{ModuleName}} extends AuthUser
{
    {{factoryHasFactoryTrait}}use HasUuids;

    /**
     * Al crearse, el usuario recibe solo el ROL BASE de su scope: el que junta
     * las abilities declaradas con `#[Ability(..., baseline: true)]` — las que
     * tiene cualquier usuario autenticado por el solo hecho de existir (ver el
     * propio perfil, cambiarse la clave).
     *
     * Lo arma y lo mantiene `php artisan mk:discover-abilities`. Si este scope
     * no declaró ninguna baseline no hay rol base, y esto es un no-op: no crea
     * roles vacíos.
     *
     * Sacá el trait si preferís asignar los roles a mano en el registro.
     */
    use AssignsBaseRole;

    /**
     * Tabla propia del scope: cada scope persiste sus usuarios aparte, nunca
     * en la tabla `auth_users` del modelo base.
     */
    protected $table = '{{moduleNamePluralLower}}';

{{apiResourceEntry}}    /**
     * Columna por la que se busca al usuario en el login.
     */
    protected string $loginField = '{{loginField}}';

    /**
     * Columnas asignables en masa.
     *
     * @var array<int, string>
     */
    protected $fillable = [
        'name',
        '{{loginField}}',
{{profileFieldsFillableEntries}}{{fileFieldsFillableEntries}}{{statusFillableEntry}}        'password',
        'auth_scope',
{{clientIdFillableEntry}}    ];

    /**
     * Casts de atributos. `password` se hashea al asignarse.
     *
     * @var array<string, string>
     */
    protected $casts = [
{{emailVerifiedAtCastEntry}}{{profileFieldsCastEntries}}{{statusCastEntry}}        'password' => 'hashed',
    ];
{{fileFieldsAppends}}
    /**
     * El scope se fija al instanciar, así `getAuthScope()` nunca devuelve null.
     */
    public function __construct(array $attributes = [])
    {
        parent::__construct($attributes);
        $this->setAuthScope('{{moduleNameLower}}');
    }{{fileFieldsAccessors}}{{factoryNewFactoryMethod}}{{rolesRelationOverride}}{{directAbilitiesRelationOverride}}{{managedByRelation}}
}
