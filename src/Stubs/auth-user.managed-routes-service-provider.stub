<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Providers;

use Illuminate\Support\ServiceProvider;

/**
 * Carga las rutas MANAGED del scope (`Http/Routes/managed.php`), las que otro
 * scope usa para administrar a éste.
 *
 * Va en un provider aparte del principal, y registrado DESPUÉS de él en
 * `bootstrap/providers.php`, a propósito: cargadas desde el mismo provider, las
 * rutas managed heredaban el middleware de las rutas propias del scope
 * (`mk.auth:{{moduleNameLower}}`) y rechazaban el token del scope que administra.
 */
class {{ModuleName}}ManagedRoutesServiceProvider extends ServiceProvider
{
    public function register(): void
    {
        //
    }

    public function boot(): void
    {
        // Solo carga managed.php. api.php es responsabilidad del SP base.
        $this->loadRoutesFrom(__DIR__ . '/../Http/Routes/managed.php');
    }
}