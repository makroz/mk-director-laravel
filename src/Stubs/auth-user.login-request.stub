<?php

declare(strict_types=1);

namespace App\Modules\{{ModuleName}}\Http\Requests;

use Illuminate\Foundation\Http\FormRequest;

/**
 * Validación para POST /api/{{moduleNameLower}}/auth/login.
 *
 * Generado por `php artisan mk:make:auth-user {{ModuleName}}`.
 *
 * Para reglas propias del login (un formato de documento, un teléfono E.164),
 * preferí `customizeLoginValidationRules()` en el `AuthController` del scope.
 */
class LoginRequest extends FormRequest
{
    public function authorize(): bool
    {
        return true; // ability check vive en BaseAuthController + middleware mk.ability.
    }

    /**
     * Reglas de validación para el endpoint /login.
     *
     * @return array<string, mixed>
     */
    public function rules(): array
    {
        return [
            '{{loginField}}' => {{loginFieldValidationRule}},
            'password' => ['required', 'string'],
        ];
    }
}
